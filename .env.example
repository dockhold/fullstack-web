# The deployed API URL. Vite inlines VITE_ vars into the bundle at BUILD time,
# so copy this to a committed `.env.production` — it's baked in when the
# Dockerfile builds. Deploy the API first, then put its URL here.
#
#   VITE_API_URL=https://fullstack-api-xxxx.dockhold.app
#
# This value is public (it ships in the browser bundle). That's fine for an API
# URL; never put secrets behind the VITE_ prefix.
VITE_API_URL=https://fullstack-api-xxxx.dockhold.app
